generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  avgScore  Float    @default(0)
  createdAt DateTime @default(now())
  isAdmin   Boolean  @default(false)

  submissions       Submission[]
  subjectSubscribed Subjectsubscribed[]
  testSubmission    TestSubmission[]
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  assignments       Assignment[]
  subjectSubscribed Subjectsubscribed[]
  tests             Test[]
}

// Discriminator for Tests: strictly PDF or MCQ
enum TestFormat {
  PDF
  MCQ
}

enum AssignmentType {
  HOMEWORK
  CLASSWORK
}

enum InputMode {
  TEXT
  PDF
}

// 1. Regular Homework & Assignments
model Assignment {
  id        Int            @id @default(autoincrement())
  title     String
  type      AssignmentType
  inputMode InputMode
  maxScore  Float          @default(100)

  textContent String? @db.Text
  fileUrl     String?

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id             Int     @id @default(autoincrement())
  score          Float
  studentFileUrl String?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, assignmentId])
}

model Subjectsubscribed {
  id Int @id @default(autoincrement())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

// 2. Strict Test Model (Either PDF or MCQ)
model Test {
  id       Int        @id @default(autoincrement())
  title    String
  format   TestFormat // Strictly 'PDF' or 'MCQ'
  maxScore Float      @default(100)
  duration Int        @default(0)

  // Filled ONLY if format == PDF
  fileUrl String?

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  // Filled ONLY if format == MCQ
  questions      Questions[]
  testSubmission TestSubmission[]
}

model TestSubmission {
  id             Int     @id @default(autoincrement())
  score          Float
  studentFileUrl String? // For PDF test responses (or null if auto-graded MCQ)

  studentAnswers String?

  startTime DateTime?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id])

  testId Int
  test   Test @relation(fields: [testId], references: [id])

  createdAt DateTime @default(now())

  isSubmitted      Boolean     @default(false)

  @@unique([studentId, testId])
}

model Questions {
  id           Int    @id @default(autoincrement())
  testId       Int
  test         Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText String @db.Text
  option1      String
  option2      String
  option3      String
  option4      String
  answer       String // Stores 'option1', 'option2', 'option3', or 'option4'
}